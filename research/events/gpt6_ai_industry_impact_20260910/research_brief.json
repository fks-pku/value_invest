  "questions": [
    {
      "id": "F1.1.1",
      "parent_id": "F1.1",
      "question": "GPT-6 是什么，背景与定位是什么？",
      "purpose": "确定研究事件与可采购产品，不把演示当交付。",
      "data": [
        "具日期官方发布、接入范围和限制",
        "前代与替代模型定位"
      ],
      "analysis": "区分首发、后续上线、知识截止日期；建立无此次发布的比较基线。",
      "support_rule": "官方日期、产品和范围相互一致。",
      "refute": "查接入限制和仍未交付的功能。"
    },
    {
      "id": "F1.1.2",
      "parent_id": "F1.1",
      "question": "GPT-6 的技术特性与能力边界怎样变化？",
      "purpose": "确定哪些任务真的改善，以及改善是否依赖特定运行框架。",
      "data": [
        "同版本基准对照、独立评测、失败案例",
        "架构披露和工具条件"
      ],
      "analysis": "分离模型、运行框架及任务贡献，不跨评测版本相减。",
      "support_rule": "至少有可定位的同任务对照并处理反向结果。",
      "refute": "寻找不提升的任务、评测框架差异和生产外推限制。"
    },
    {
      "id": "F1.1.3",
      "parent_id": "F1.1",
      "question": "GPT-6 的成本与使用经济性怎样变化？",
      "purpose": "判断能力改善能否抵消更贵的模型调用。",
      "data": [
        "历史API价格、任务级费用和质量",
        "训练、服务成本披露及人工复核成本"
      ],
      "analysis": "分开厂商成本、报价和用户合格任务总成本；给可复算盈亏平衡条件。",
      "support_rule": "价格可追溯、任务口径可比，未披露成本不反推。",
      "refute": "查质量接近但价格更高的任务，以及集成和复核成本。"
    },
    {
      "id": "F1.2.1",
      "parent_id": "F1.2",
      "question": "怎样影响上游算力与基础设施？",
      "purpose": "把任务需求变成资源消耗，再检验采购和收入桥接。",
      "data": [
        "单位任务资源、硬件效率、利用率与订单",
        "canonical BOM边界和供应商财报"
      ],
      "analysis": "区分训练存量与推理增量；按任务量×资源强度÷有效供给效率推演。",
      "support_rule": "有任务到资源再到订单的证据；情景不得替代实际。",
      "refute": "查效率提升、存量利用率、订单先于发布和替代路线。"
    },
    {
      "id": "F1.2.2",
      "parent_id": "F1.2",
      "question": "怎样影响中游模型与服务平台？",
      "purpose": "判断模型领先能否转成渠道、客户和利润的控制力。",
      "data": [
        "竞品同口径性能费用、上线渠道与合同",
        "云平台分部收入和利润"
      ],
      "analysis": "分开模型定价权和平台分发价值，处理竞争追赶及多模型路由。",
      "support_rule": "渠道与竞争事实可验证，盈利幅度有依据。",
      "refute": "寻找不领先任务、渠道非独占和单位利润被竞争侵蚀。"
    },
    {
      "id": "F1.2.3",
      "parent_id": "F1.2",
      "question": "怎样影响下游应用与最终需求？",
      "purpose": "检验能力提升是否进入持续付费，而不是只有试用热度。",
      "data": [
        "客户、具体任务、产品上线与付费基线",
        "生产转化、续用、预算及替代支出"
      ],
      "analysis": "比较新增需求、替代需求和原有需求升级，识别高价值可验收任务。",
      "support_rule": "区分产品供给与已付费需求；可持续新增需客户数据。",
      "refute": "查设计伙伴不是付费客户、成本无优势和软件替代风险。"
    },
    {
      "id": "F1.3.1",
      "parent_id": "F1.3",
      "question": "哪些公司具有可验证的业务敞口，值得进一步研究？",
