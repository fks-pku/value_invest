  "questions": [
    {
      "id": "Q1.1.1",
      "parent_id": "Q1.1",
      "question": "GPT-6 Astra 何时发布、提供哪些能力、哪些尚不是可用产品或商业事实？",
      "data": [
        "官方发布日志、模型文档与产品接入范围",
        "限制、可用性和营销措辞的边界"
      ],
      "analysis": "拆分发布日期、产品功能、官方评测和未来承诺，不把知识截止日当发布日期。",
      "refute": "寻找未上线、受限接入和基准不适用的说明。"
    },
    {
      "id": "Q1.1.2",
      "parent_id": "Q1.1",
      "question": "相对 GPT-5.6 Sol，能力提升是否意味着可验收任务的总成本下降？",
      "data": [
        "同任务评测、执行耗时、输入输出量和成功率",
        "截至截面的 API 单价、缓存与计费条件",
        "人工复核、重试和错误成本"
      ],
      "analysis": "从每 token 价格转为每个验收任务的全成本；统一 harness、难度和推理设置。",
      "refute": "寻找没有改善的评测、溢价和人工成本未下降的场景。"
    },
    {
      "id": "Q1.2.1",
      "parent_id": "Q1.2",
      "question": "哪些 AI 应用需求最可能被放大，能否从试用跨到企业付费工作流？",
      "data": [
        "软件、研究、文档等具体任务的能力边界",
        "企业采用、付费与生产环境约束",
        "客户试用与真实收入的区分"
      ],
      "analysis": "按可验收性、错误代价、工作频率及集成成本排序，不把基准分数换算成市场规模。",
      "refute": "寻找人类复核、安全、数据权限和部署瓶颈。"
    },
    {
      "id": "Q1.2.2",
      "parent_id": "Q1.2",
      "question": "GPT-6 对推理算力、GPU 和配套基础设施的净需求方向及规模能否被验证？",
      "data": [
        "每项任务的 token、计算与时延变化",
        "任务量增长、工作负载结构和硬件效率",
        "云厂商资本开支、采购和供货的发布前后区分"
      ],
      "analysis": "拆分任务量、单任务计算强度、模型路由和硬件效率，验证需求反弹阈值和采购归因。",
      "refute": "检验推理效率提高、低价模型分流和既有产能消化是否抵消新增任务量。"
    },
    {
      "id": "Q1.2.3",
      "parent_id": "Q1.2",
      "question": "模型平台、云渠道和应用软件之间的竞争与价值分配会怎样改变？",
      "data": [
        "独立评测与竞争模型能力、价格和渠道",
        "平台工具与企业软件的业务边界",
        "分销、业务数据、权限、责任和工作流控制"
      ],
      "analysis": "区分模型能力护城河与渠道/系统记录护城河；识别既受益又受挤压的公司。",
      "refute": "检验多模型路由、竞品追赶及模型平台跨入应用层的替代风险。"
    },
    {
      "id": "Q1.3.1",
      "parent_id": "Q1.3",
      "question": "哪些行业和公司观察值得保留，什么数据会推翻本次判断？",
      "data": [
        "子问题的可验证结论与未闭环缺口",
        "公司业务敞口、增量盈利与估值验证是否齐备",
        "可执行的接受率、成本、收入和风险阈值"
      ],
      "analysis": "区分基本面变化、市场共识与已定价；只汇总已验证部分，未验证的盈利和估值不打分。",
      "refute": "设定全成本恶化、事故、付费不转化和采购不兑现时的降级条件。"
    }
  ],
